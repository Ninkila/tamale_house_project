# Tamale House Market - Environment Configuration Template
# Copy this file to .env and customize the values for your environment.
# DO NOT commit real secrets or production credentials to Git.

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
HOST=0.0.0.0
PORT=5000

# PostgreSQL Database Configuration
# Individual connection parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tamale_house_market
DB_USER=tamale_user
DB_PASSWORD=tamale_dev_password

# Primary PostgreSQL Connection URL:
DATABASE_URL=postgresql://tamale_user:tamale_dev_password@localhost:5432/tamale_house_market

# Isolated PostgreSQL Test Database URL (for integration tests):
# Run tests against a separate database to preserve production and development data:
TEST_DATABASE_URL=postgresql://tamale_user:tamale_dev_password@localhost:5432/tamale_house_market_test
