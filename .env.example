# Matches the local PostgreSQL service in docker-compose.yml.
POSTGRES_USER=tamale_user
POSTGRES_PASSWORD=tamale_dev_password
POSTGRES_DB=tamale_house_market
DATABASE_URL=postgresql://tamale_user:tamale_dev_password@localhost:5432/tamale_house_market
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
